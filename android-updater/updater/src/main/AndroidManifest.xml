<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application>
        <meta-data android:name="org.godotengine.plugin.v2.CHKUpdater" android:value="com.chasmet.chk.updater.CHKUpdater" />
        <provider android:name="com.chasmet.chk.updater.UpdateFileProvider"
            android:authorities="${applicationId}.chkupdates"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/chk_update_paths" />
        </provider>
    </application>
</manifest>
