; CHK Pirate Warrior 2 - Godot 4
config_version=5

[application]
config/name="CHK Pirate Warrior 2"
run/main_scene="res://scenes/main/main.tscn"
config/icon="res://assets/interface/logo_chk_pirate_warrior_2.png"

[autoload]
GameState="*res://scripts/systems/game_state.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display/window]
size/viewport_width=1280
size/viewport_height=720
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
stretch/aspect="expand"
handheld/orientation=0

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
