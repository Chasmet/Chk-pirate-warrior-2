; CHK Pirate Warrior 2 - Godot 4
config_version=5

[application]
config/name="CHK Pirate Warrior 2"
run/main_scene="res://scenes/main/main.tscn"

[autoload]
GameState="*res://scripts/systems/game_state.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"

[display]

[display/window]
size/viewport_width=1920
size/viewport_height=1080
size/window_width_override=1280
size/window_height_override=720
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":74)]}
dodge={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":75)]}
ability_1={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
ability_2={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":59)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
embark={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":66)]}
open_inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
open_map={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":77)]}
quick_save={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
pause_game={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":80)]}
